#include <stdio.h>

void swap(int *a, int *b) {
    int t = *a; *a = *b; *b = t;
}

void heapify(int a[], int n, int i, int isMax) {
    int x = i, l = 2*i+1, r = 2*i+2;

    if (l < n && (isMax ? a[l] > a[x] : a[l] < a[x])) x = l;
    if (r < n && (isMax ? a[r] > a[x] : a[r] < a[x])) x = r;

    if (x != i) {
        swap(&a[i], &a[x]);
        heapify(a, n, x, isMax);
    }
}

int main() {
    int a[] = {12, 11, 13, 5, 6, 7};
    int n = 6;

    for (int i = n/2 - 1; i >= 0; i--) heapify(a, n, i, 1);
    printf("Max Heap: ");
    for (int i = 0; i < n; i++) printf("%d ", a[i]);

    int b[] = {12, 11, 13, 5, 6, 7};
    for (int i = n/2 - 1; i >= 0; i--) heapify(b, n, i, 0);
    printf("\nMin Heap: ");
    for (int i = 0; i < n; i++) printf("%d ", b[i]);

    return 0;
}
