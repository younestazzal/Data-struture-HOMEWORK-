#include <stdio.h>

typedef struct {
    int r, c, v;
} Sparse;

void makeSparse(int m[4][4]) {
    Sparse s[15];
    int k = 1;

    for (int i = 0; i < 4; i++)
        for (int j = 0; j < 4; j++)
            if (m[i][j])
                s[k++] = (Sparse){i, j, m[i][j]};

    s[0] = (Sparse){4, 4, k - 1};

    printf("R C V\n");
    for (int i = 0; i < k; i++)
        printf("%d %d %d\n", s[i].r, s[i].c, s[i].v);
}

int main() {
    int data[4][4] = {
        {0, 0, 3, 0},
        {0, 0, 0, 0},
        {0, 5, 0, 0},
        {0, 0, 0, 0}
    };

    makeSparse(data);
    return 0;
}
