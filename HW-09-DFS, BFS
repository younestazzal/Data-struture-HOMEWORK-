from collections import deque

graph = {
    0: [1, 2],
    1: [0, 3],
    2: [0],
    3: [1]
}

def dfs(start):
    stack, visited = [start], set()
    while stack:
        v = stack.pop()
        if v not in visited:
            print(v, end=" ")
            visited.add(v)
            stack.extend(reversed(graph[v]))

def bfs(start):
    q, visited = deque([start]), {start}
    while q:
        v = q.popleft()
        print(v, end=" ")
        for n in graph[v]:
            if n not in visited:
                visited.add(n)
                q.append(n)

dfs(0)
print()
bfs(0)
