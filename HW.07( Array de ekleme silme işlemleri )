#include <stdio.h>

int insert(int a[], int n, int p, int v) {
    for (; n > p; n--) a[n] = a[n-1];
    a[p] = v;
    return n + 1;
}

int del(int a[], int n, int p) {
    printf("Item %d removed\n", a[p]);
    for (; p < n-1; p++) a[p] = a[p+1];
    return n - 1;
}

int find(int a[], int n, int x) {
    for (int i = 0; i < n; i++)
        if (a[i] == x) return i;
    return -1;
}

int main() {
    int a[100] = {10, 20, 30, 40, 50}, n = 5;

    n = insert(a, n, 2, 99);

    int idx = find(a, n, 99);
    if (idx >= 0) printf("99 found at index %d\n", idx);

    n = del(a, n, 2);

    printf("Final Array: ");
    for (int i = 0; i < n; i++) printf("%d ", a[i]);
    return 0;
}
